<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Borizon is offline-first. Block all cleartext and untrusted traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
