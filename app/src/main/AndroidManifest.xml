<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice input for conversational interface -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Internet access for model download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric authentication for privacy lock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notifications for journaling reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for model download -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Schedule exact alarms for journaling reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Set alarms/timers via system clock app (required by Samsung etc.) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Calendar access for reading events -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Contact access for reading/creating contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Phone call (opens dialer, no CALL_PHONE needed for ACTION_DIAL) -->

    <!-- Location for current position -->
    <!-- REMOVED: deviceControl tool removed, location no longer needed -->

    <!-- SMS reading -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Call log reading -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- REMOVED: UsageStatsTools removed, no longer needed -->
    <!-- <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" /> -->

    <!-- REMOVED: DndTools removed, no longer needed -->
    <!-- <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" /> -->

    <!-- REMOVED: GalleryTools removed, no longer needed -->
    <!-- <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> -->
    <!-- <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" -->
    <!--     android:maxSdkVersion="32" /> -->

    <!-- Query installed apps by launcher intent (replaces QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.biometrics"
        android:required="false" />

    <!-- largeHeap required: on-device LLM inference (LiteRT) + bitmap processing for camera capture -->
    <application
        android:name=".BorizonApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Borizon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:exported="true">

        <!-- Main activity — animated splash handled in Compose -->
        <activity
            android:name=".ui.screens.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="colorMode|density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:theme="@style/Theme.Borizon.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- File provider for sharing exported content -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Share sheet receiver for ingesting external content -->
        <activity
            android:name=".ui.screens.IngestActivity"
            android:exported="true"
            android:theme="@style/Theme.Borizon"
            android:label="Add to Borizon">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Notification listener for reading phone notifications -->
        <service
            android:name=".ai.notifications.BorizonNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager foreground service for model downloads -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:directBootAware="false" />

    </application>

</manifest>
